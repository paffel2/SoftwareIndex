<?xml version="1.0" encoding="utf-8"?>
<!-- Диалог добавления или изменения компьютера в классе -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Заголовок окна -->
        <TextView
            android:id="@+id/tv_dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/title_add_computer"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Ввод названия / номера ЭВМ -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_comp_name"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/hint_comp_name"
            app:startIconDrawable="@drawable/ic_computer">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_comp_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Ввод спецификаций ЭВМ (Процессор, ОЗУ, Диск) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_comp_specs"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/hint_comp_specs"
            app:startIconDrawable="@drawable/ic_specs">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_comp_specs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>
</ScrollView>