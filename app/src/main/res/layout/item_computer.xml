<?xml version="1.0" encoding="utf-8"?>
<!-- Разметка карточки отдельного компьютера в списке детального просмотра класса -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_view_computer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Название / марка / номер рабочего места ЭВМ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_computer"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/tv_computer_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Рабочая станция №1" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="?attr/colorOutlineVariant" />

        <!-- Подробная спецификация (процессор, ОЗУ, накопитель) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginTop="2dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_specs"
                app:tint="?attr/colorSecondary" />

            <TextView
                android:id="@+id/tv_computer_specs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:lineSpacingExtra="2dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp"
                tools:text="Intel Core i5-11400, 16 ГБ ОЗУ, SSD 512 ГБ, Intel UHD 730" />
        </LinearLayout>

        <!-- Кнопки действий над ПК (Изменить / Удалить) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <!-- Изменить данные ПК -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit_comp"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_edit_short"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp"
                app:icon="@drawable/ic_edit"
                app:iconSize="14dp"
                app:iconTint="?attr/colorPrimary" />

            <!-- Удалить ПК из класса -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete_comp"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/btn_delete_short"
                android:textColor="#EF4444"
                android:textSize="12sp"
                app:icon="@drawable/ic_delete"
                app:iconSize="14dp"
                app:iconTint="#EF4444" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>